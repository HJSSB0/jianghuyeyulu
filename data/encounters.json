  "e_ligao_teach": {
    "id": "e_ligao_teach",
    "name": "奇遇·书生论侠",
    "type": "奇遇",
    "desc": "李墨在墙根下晒书。",
    "trigger": {
      "npc": "li_mo",
      "attr_gte": {
        "attr": "悟性",
        "val": 6
      }
    },
    "text": "李墨抚卷而笑：'少侠目光沉静，想是有几分悟性。老生有一问：侠之大者，为何？'",
    "options": [
      {
        "text": "'为国为民。'",
        "morality": {
          "仁": 10,
          "义": 5
        },
        "exp": 80,
        "after": "李墨击节赞叹：'好一个为国为民！'他赠你一部手抄兵法。"
      },
      {
        "text": "'快意恩仇。'",
        "morality": {
          "勇": 10
        },
        "exp": 50,
        "after": "李墨微微一笑：'快意恩仇，也是江湖本色。'"
      },
      {
        "text": "'不知。愿闻其详。'",
        "exp": 60,
        "morality": {
          "仁": 5
        },
        "after": "李墨讲了一个时辰，你听得入神，若有所悟。"
      }
    ]
  },
