  "e_xin_offer": {
    "id": "e_xin_offer",
    "name": "奇遇·一封旧信",
    "type": "奇遇",
    "desc": "玄尘把你叫住，从蓑衣最里层摸出一封信。",
    "trigger": {
      "npc": "xuanchen",
      "lv_gte": 2,
      "once": "e_xin_offer"
    },
    "text": "信的火漆完好，边角却磨得发亮。玄尘递信的手在抖——很轻，但确实是抖。'这封信，我替你娘收了二十年。'他停了停，'收得太久了。'",
    "options": [
      {
        "text": "接过信",
        "items": {
          "q_xuanchen_xin": 1
        },
        "affinity": {
          "npc": "xuanchen",
          "val": 10
        },
        "quest": "s_xin",
        "after": "'有些事，你不知道，才活得了。'玄尘看着你，'可你既然要走江湖——有些事，也该知道了。'"
      },
      {
        "text": "还没准备好",
        "after": "玄尘点点头，把信收回蓑衣：'不急。信等得起人，人等不起信。'（此事就此作罢）"
      }
    ]
  },
  "e_xin_choice": {
    "id": "e_xin_choice",
    "name": "奇遇·信的去向",
    "type": "奇遇",
    "desc": "信在怀里，像一块烧红的炭。",
    "trigger": {
      "npc": "xuanchen",
      "quest_gte": {
        "quest": "s_xin",
        "step": 1
      }
    },
    "text": "拆开火漆，信纸上只有一行字，笔锋很稳，落款是一个'灯'字。玄尘在一旁看着，不说话。",
    "options": [
      {
        "text": "就着火盆烧了",
        "items": {
          "q_xuanchen_xin": -1
        },
        "morality": {
          "仁": 5
        },
        "quest_step": {
          "quest": "s_xin"
        },
        "after": "纸灰飞起来的时候，玄尘轻轻舒了一口气，像放下了背了二十年的东西：'你娘会喜欢这个决定。'"
      },
      {
        "text": "把信收进怀里最深处",
        "morality": {
          "勇": 3
        },
        "counter": {
          "key": "xin_kept",
          "val": 1
        },
        "quest_step": {
          "quest": "s_xin"
        },
        "after": "'也好。'玄尘不再多话。有些东西留着，不是为了看，是为了有一天不得不看。"
      }
    ]
  },
  "e_meng_offer": {
    "id": "e_meng_offer",
    "name": "奇遇·一碗水酒",
    "type": "奇遇",
    "desc": "孟千难得没笑。",
    "trigger": {
      "npc": "meng_qian",
      "lv_gte": 3,
      "once": "e_meng_offer"
    },
    "text": "孟千望着北边，看了很久。'小友，替我跑一趟西山河畔。芦苇最深处，倒一碗女儿红。'他顿了顿，'不必问给谁。'",
    "options": [
      {
        "text": "接下这桩差事",
        "quest": "s_meng",
        "after": "'五十年前，有人在西山拦下过一伙臂上纹弯月的人。'他的声音很平，'拦他们的人，都没有回来。我爹是其中一个。'他终于笑了，笑得比哭还淡。'酒钱你先垫，回来我补上。'"
      },
      {
        "text": "婉拒",
        "after": "孟千又笑了，像什么都没发生过：'也是。这年月，谁没点自己的事。'（此事就此作罢）"
      }
    ]
  },
  "e_guiju_offer": {
    "id": "e_guiju_offer",
    "name": "奇遇·三条规矩",
    "type": "奇遇",
    "desc": "铁捕头把你拉到告示板背面。",
    "trigger": {
      "npc": "tie_putou",
      "lv_gte": 3,
      "once": "e_guiju_offer"
    },
    "text": "'你从那村子来的？'铁捕头声音压得很低，'那你比谁都清楚——黑衣人不是山贼。官府查不动他们。你，可以。'",
    "options": [
      {
        "text": "接下查案",
        "quest": "s_guiju",
        "after": "'三条规矩。'他竖起三根手指，'孩子的眼睛，市井的耳目，教众身上的令。凑齐了，来找我。'"
      },
      {
        "text": "只想安静练功",
        "after": "铁捕头点点头，没有勉强。告示板上的浆糊，还是新的。（此事就此作罢）"
      }
    ]
  },
  "e_citang_offer": {
    "id": "e_citang_offer",
    "name": "奇遇·祠堂",
    "type": "奇遇",
    "desc": "柳绵绵攥着那串旧钥匙。",
    "trigger": {
      "npc": "liumianmian",
      "lv_gte": 2,
      "once": "e_citang_offer"
    },
    "text": "'祠堂塌了半边，可神像还在。'她把钥匙擦了又擦，'娘说过，村子没了，根不能没。我想把它修起来。'",
    "options": [
      {
        "text": "答应帮她备料",
        "quest": "s_citang",
        "after": "'北郊的木头硬实。'她的眼睛亮了一下，像雨夜后点起的第一盏灯。"
      },
      {
        "text": "如今自身难保",
        "after": "她低下头：'……嗯。我再等等。'（此事就此作罢）"
      }
    ]
  },
  "e_xuanchen_xin": {
    "id": "e_xuanchen_xin",
    "name": "奇遇·二十年没寄的信",
    "type": "奇遇",
    "desc": "你带着那封落款「灯」的旧信。玄尘的檐下，雨声很轻。",
    "trigger": {
      "npc": "xuanchen",
      "item": {
        "id": "q_xuanchen_xin",
        "n": 1
      }
    },
    "text": "玄尘接过信，蓑衣的袖口停了很久很久。\n「二十年了。」他说，「墨都淡了，字还没淡。」",
    "options": [
      {
        "text": "「这信，是写给谁的？」",
        "affinity": {
          "npc": "xuanchen",
          "val": 8
        },
        "counter": {
          "key": "xuanchen_truth",
          "val": 1
        },
        "after": "「写给一个还没来问的孩子。」他看着你，「现在，你来了。」"
      },
      {
        "text": "「烧了它吧。有些事该过去了。」",
        "morality": {
          "义": 8
        },
        "counter": {
          "key": "letter_burned",
          "val": 1
        },
        "after": "火光跳了一下。蓑衣的下摆，忽然轻了一寸。"
      }
    ]
  },
  "qiaogu_xiu": {
    "id": "qiaogu_xiu",
    "name": "奇遇·帕上的鹤",
    "type": "奇遇",
    "desc": "你说起柳绵绵绣帕上那只鹤。巧姑的针，停在半空。",
    "trigger": {
      "npc": "qiao_gu",
      "quest_done": "f_liu1"
    },
    "text": "「那只鹤的针法，是我师父的。」巧姑说，「全村只有我们两个人会。」\n她顿了顿：「师父死在雨夜。帕子的小姑娘，活了下来。」",
    "options": [
      {
        "text": "「替她绣一只新的，行吗？」",
        "items": {
          "g_chouduan": -1
        },
        "morality": {
          "仁": 8
        },
        "affinity": {
          "npc": "liumianmian",
          "val": 10
        },
        "after": "三日后，一只振翅的新鹤送到柳绵绵手里。她没说话，把帕子贴身收好了。（柳绵绵好感+10）"
      },
      {
        "text": "「先记下这笔心意。」",
        "affinity": {
          "npc": "qiao_gu",
          "val": 5
        },
        "after": "巧姑点头，把绷子上的鹤又添了一针。"
      }
    ]
  }
}
