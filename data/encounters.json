  },
  "e_shanmiao": {
    "id": "e_shanmiao",
    "name": "奇遇·小乞儿",
    "type": "奇遇",
    "desc": "北郊山神庙里缩着一个小乞儿。",
    "trigger": {
      "npc": "shanmiao_qier"
    },
    "text": "小乞儿抱着膝盖：'别抢我的饼！……你要是给饼，那没事了。'",
    "options": [
      {
        "text": "给他馒头",
        "items": {
          "c_mantou": -1
        },
