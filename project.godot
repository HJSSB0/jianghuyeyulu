; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="江湖夜雨录"
config/description="大侠立志传 × 烟雨江湖 融合复刻 · 垂直切片"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameDB="*res://autoload/GameDB.gd"
GameState="*res://autoload/GameState.gd"
Battle="*res://autoload/Battle.gd"
SaveSystem="*res://autoload/SaveSystem.gd"
CloudSync="*res://autoload/CloudSync.gd"

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/unsafe_cast_from_variant=0

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/handheld/orientation=4

